{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://ballisticsworkbench.local/schemas/ballistics-drag-data.schema.json",
    "title": "Ballistics Workbench drag-data interchange",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "format",
        "schemaVersion",
        "exportedAt",
        "name",
        "units",
        "source",
        "declaredDomain",
        "drag",
        "payloadChecksumSha256"
    ],
    "properties": {
        "format": {
            "const": "ballistics-workbench-drag-data"
        },
        "schemaVersion": {
            "const": 1
        },
        "exportedAt": {
            "$ref": "#/$defs/timestamp"
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
        },
        "units": {
            "$ref": "#/$defs/units"
        },
        "source": {
            "$ref": "#/$defs/source"
        },
        "declaredDomain": {
            "$ref": "#/$defs/domain"
        },
        "drag": {
            "oneOf": [
                {
                    "$ref": "#/$defs/constantBc"
                },
                {
                    "$ref": "#/$defs/bandedBc"
                },
                {
                    "$ref": "#/$defs/machCd"
                }
            ]
        },
        "payloadChecksumSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        }
    },
    "$defs": {
        "timestamp": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
        },
        "units": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "velocity",
                "referenceDiameter",
                "mach",
                "dragCoefficient",
                "ballisticCoefficient"
            ],
            "properties": {
                "velocity": {
                    "const": "m/s"
                },
                "referenceDiameter": {
                    "const": "m"
                },
                "mach": {
                    "const": "dimensionless"
                },
                "dragCoefficient": {
                    "const": "dimensionless"
                },
                "ballisticCoefficient": {
                    "const": "lb/in^2"
                }
            }
        },
        "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["citation", "url", "license", "checksumSha256"],
            "properties": {
                "citation": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                },
                "url": {
                    "type": ["string", "null"],
                    "maxLength": 2000,
                    "pattern": "^https?://"
                },
                "license": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                },
                "checksumSha256": {
                    "type": ["string", "null"],
                    "pattern": "^[0-9a-f]{64}$"
                }
            }
        },
        "domain": {
            "type": "object",
            "additionalProperties": false,
            "required": ["variable", "minimum", "maximum", "unit"],
            "properties": {
                "variable": {
                    "enum": ["velocity", "mach"]
                },
                "minimum": {
                    "type": ["number", "null"],
                    "minimum": 0
                },
                "maximum": {
                    "type": ["number", "null"],
                    "exclusiveMinimum": 0
                },
                "unit": {
                    "enum": ["m/s", "Mach"]
                }
            }
        },
        "bcBand": {
            "type": "object",
            "additionalProperties": false,
            "required": ["minimumVelocityMps", "ballisticCoefficient"],
            "properties": {
                "minimumVelocityMps": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2000
                },
                "ballisticCoefficient": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 2
                }
            }
        },
        "constantBc": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "curve", "representation", "ballisticCoefficient"],
            "properties": {
                "kind": {
                    "const": "referenceBc"
                },
                "curve": {
                    "enum": ["G1", "G7"]
                },
                "representation": {
                    "const": "constant"
                },
                "ballisticCoefficient": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 2
                }
            }
        },
        "bandedBc": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "curve", "representation", "velocityBands"],
            "properties": {
                "kind": {
                    "const": "referenceBc"
                },
                "curve": {
                    "enum": ["G1", "G7"]
                },
                "representation": {
                    "const": "velocityBands"
                },
                "velocityBands": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 16,
                    "items": {
                        "$ref": "#/$defs/bcBand"
                    }
                }
            }
        },
        "machCdPoint": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mach", "dragCoefficient"],
            "properties": {
                "mach": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10
                },
                "dragCoefficient": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 5
                }
            }
        },
        "machCd": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "referenceDiameterM", "points"],
            "properties": {
                "kind": {
                    "const": "machCd"
                },
                "referenceDiameterM": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 0.05
                },
                "points": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 64,
                    "items": {
                        "$ref": "#/$defs/machCdPoint"
                    }
                }
            }
        }
    }
}
