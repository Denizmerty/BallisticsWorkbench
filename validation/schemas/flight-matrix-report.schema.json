{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://ballisticsworkbench.local/schemas/flight-matrix-report.schema.json",
    "title": "Ballistics Workbench independent flight-matrix residual report",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "reportType",
        "engineVersion",
        "modelVersion",
        "compiler",
        "referenceArtifact",
        "evidenceLevel",
        "passed",
        "aggregate",
        "categories",
        "scenarios",
        "zeroingCases",
        "mpbrCases"
    ],
    "properties": {
        "schemaVersion": { "const": 1 },
        "reportType": { "const": "independent_flight_matrix" },
        "engineVersion": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": "string", "minLength": 1 },
        "compiler": { "type": "string", "minLength": 1 },
        "referenceArtifact": { "const": "independent-flight-matrix-rk4-v1" },
        "evidenceLevel": { "const": "independent_implementation_numerical_conformance" },
        "passed": { "type": "boolean" },
        "aggregate": { "$ref": "#/$defs/aggregate" },
        "categories": {
            "type": "array",
            "minItems": 7,
            "uniqueItems": true,
            "items": {
                "enum": [
                    "environment",
                    "wind_vector",
                    "geometry",
                    "low_velocity",
                    "tabulated_drag",
                    "sphere",
                    "builtin_load"
                ]
            }
        },
        "scenarios": {
            "type": "array",
            "minItems": 13,
            "items": { "$ref": "#/$defs/scenarioReport" }
        },
        "zeroingCases": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/zeroingReport" }
        },
        "mpbrCases": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/mpbrReport" }
        }
    },
    "$defs": {
        "residuals": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "positionM",
                "velocityMps",
                "timeS",
                "groundSpeedMps",
                "airspeedMps",
                "mach",
                "dragCoefficient"
            ],
            "properties": {
                "positionM": { "type": "number", "minimum": 0 },
                "velocityMps": { "type": "number", "minimum": 0 },
                "timeS": { "type": "number", "minimum": 0 },
                "groundSpeedMps": { "type": "number", "minimum": 0 },
                "airspeedMps": { "type": "number", "minimum": 0 },
                "mach": { "type": "number", "minimum": 0 },
                "dragCoefficient": { "type": "number", "minimum": 0 }
            }
        },
        "aggregate": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "scenarioCount",
                "sampleCount",
                "zeroingCaseCount",
                "mpbrCaseCount",
                "positionM",
                "velocityMps",
                "timeS",
                "groundSpeedMps",
                "airspeedMps",
                "mach",
                "dragCoefficient"
            ],
            "properties": {
                "scenarioCount": { "type": "integer", "minimum": 13 },
                "sampleCount": { "type": "integer", "minimum": 65 },
                "zeroingCaseCount": { "type": "integer", "minimum": 1 },
                "mpbrCaseCount": { "type": "integer", "minimum": 1 },
                "positionM": { "type": "number", "minimum": 0 },
                "velocityMps": { "type": "number", "minimum": 0 },
                "timeS": { "type": "number", "minimum": 0 },
                "groundSpeedMps": { "type": "number", "minimum": 0 },
                "airspeedMps": { "type": "number", "minimum": 0 },
                "mach": { "type": "number", "minimum": 0 },
                "dragCoefficient": { "type": "number", "minimum": 0 }
            }
        },
        "scenarioReport": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "category",
                "dragModel",
                "sampleCount",
                "termination",
                "passed",
                "maximumResiduals"
            ],
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "category": { "type": "string", "minLength": 1 },
                "dragModel": { "enum": ["G1", "G7", "sphere", "tabulatedCd"] },
                "sampleCount": { "type": "integer", "minimum": 5 },
                "termination": { "type": "string", "minLength": 1 },
                "passed": { "type": "boolean" },
                "maximumResiduals": { "$ref": "#/$defs/residuals" }
            }
        },
        "zeroingReport": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "status",
                "sampleCount",
                "boreAngleResidualRad",
                "zeroResidualM",
                "pathResidualM",
                "timeResidualS",
                "velocityResidualMps",
                "passed"
            ],
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "status": { "type": "string", "minLength": 1 },
                "sampleCount": { "type": "integer", "minimum": 6 },
                "boreAngleResidualRad": { "type": "number", "minimum": 0 },
                "zeroResidualM": { "type": "number", "minimum": 0 },
                "pathResidualM": { "type": "number", "minimum": 0 },
                "timeResidualS": { "type": "number", "minimum": 0 },
                "velocityResidualMps": { "type": "number", "minimum": 0 },
                "passed": { "type": "boolean" }
            }
        },
        "mpbrReport": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "status",
                "zeroResidualM",
                "mpbrResidualM",
                "maximumPathResidualM",
                "passed"
            ],
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "status": { "type": "string", "minLength": 1 },
                "zeroResidualM": { "type": "number", "minimum": 0 },
                "mpbrResidualM": { "type": "number", "minimum": 0 },
                "maximumPathResidualM": { "type": "number", "minimum": 0 },
                "passed": { "type": "boolean" }
            }
        }
    }
}
