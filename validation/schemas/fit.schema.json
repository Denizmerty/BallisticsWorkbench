{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://ballisticsworkbench.local/schemas/validation-fit.schema.json",
    "title": "Ballistics Workbench reproducible reference-BC fit",
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion", "id", "model", "parameters", "observations", "method"],
    "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
        "model": { "enum": ["G1", "G7"] },
        "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "loadId",
                "massKg",
                "muzzleVelocityMps",
                "initialBallisticCoefficient",
                "implementedBallisticCoefficient",
                "fitKind",
                "coefficientToleranceAbsolute",
                "atmosphere",
                "parameterStatus",
                "evidenceLevel",
                "uncertaintyQualification",
                "assumptions"
            ],
            "properties": {
                "loadId": { "type": "string", "pattern": "^builtin:[a-z0-9-]+$" },
                "massKg": { "type": "number", "exclusiveMinimum": 0 },
                "muzzleVelocityMps": { "type": "number", "minimum": 1, "maximum": 2000 },
                "initialBallisticCoefficient": { "type": "number", "minimum": 0.005, "maximum": 2 },
                "implementedBallisticCoefficient": {
                    "type": "number",
                    "minimum": 0.005,
                    "maximum": 2
                },
                "fitKind": { "const": "constant" },
                "coefficientToleranceAbsolute": { "type": "number", "exclusiveMinimum": 0 },
                "atmosphere": { "$ref": "#/$defs/atmosphere" },
                "parameterStatus": { "const": "fitted_to_same_table" },
                "evidenceLevel": { "const": "calibration_only" },
                "uncertaintyQualification": { "type": "string", "minLength": 1 },
                "assumptions": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "minLength": 1 }
                }
            }
        },
        "observations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": { "$ref": "#/$defs/observation" }
        },
        "method": {
            "type": "object",
            "additionalProperties": false,
            "required": ["implementation", "objective", "optimizer", "version", "randomSeed"],
            "properties": {
                "implementation": { "const": "calibrate_reference_ballistic_coefficient" },
                "objective": { "type": "string", "minLength": 1 },
                "optimizer": { "const": "Levenberg-Marquardt over log ballistic coefficient" },
                "version": { "type": "string", "minLength": 1 },
                "randomSeed": { "const": null }
            }
        }
    },
    "$defs": {
        "atmosphere": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "temperatureC",
                "stationPressureHpa",
                "relativeHumidityPercent",
                "headwindMps",
                "crosswindMps",
                "qualification"
            ],
            "properties": {
                "temperatureC": { "type": "number", "minimum": -60, "maximum": 60 },
                "stationPressureHpa": { "type": "number", "minimum": 100, "maximum": 1200 },
                "relativeHumidityPercent": { "type": "number", "minimum": 0, "maximum": 100 },
                "headwindMps": { "type": "number", "minimum": -100, "maximum": 100 },
                "crosswindMps": { "type": "number", "minimum": -100, "maximum": 100 },
                "qualification": { "type": "string", "minLength": 1 }
            }
        },
        "observation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "distanceM",
                "velocityMps",
                "standardDeviationMps",
                "rangeStandardDeviationM",
                "role",
                "sourceId",
                "lot",
                "barrel"
            ],
            "properties": {
                "distanceM": { "type": "number", "exclusiveMinimum": 0, "maximum": 2000 },
                "velocityMps": { "type": "number", "minimum": 1, "maximum": 2000 },
                "standardDeviationMps": { "type": "number", "minimum": 0.01, "maximum": 200 },
                "rangeStandardDeviationM": { "type": ["number", "null"], "minimum": 0 },
                "role": { "enum": ["calibration", "holdout"] },
                "sourceId": { "type": "string", "minLength": 1 },
                "lot": { "type": ["string", "null"] },
                "barrel": { "type": ["string", "null"] }
            }
        }
    }
}
