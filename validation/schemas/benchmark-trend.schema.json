{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://ballisticsworkbench.local/schemas/benchmark-trend.schema.json",
    "title": "Ballistics Workbench native benchmark trend",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "engineVersion",
        "modelVersion",
        "platform",
        "compiler",
        "hardwareConcurrency",
        "policy",
        "compatibleBaselineRunId",
        "comparisons"
    ],
    "properties": {
        "schemaVersion": { "const": 1 },
        "engineVersion": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "compiler": { "type": "string", "minLength": 1 },
        "hardwareConcurrency": { "type": "integer", "minimum": 1 },
        "policy": { "type": "string", "minLength": 1 },
        "compatibleBaselineRunId": { "type": ["string", "null"] },
        "comparisons": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/comparison" }
        }
    },
    "$defs": {
        "nullableNumber": { "type": ["number", "null"] },
        "comparison": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "medianMs",
                "p95Ms",
                "baselineMedianMs",
                "baselineP95Ms",
                "medianChangePercent",
                "p95ChangePercent"
            ],
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "medianMs": { "type": "number", "minimum": 0 },
                "p95Ms": { "type": "number", "minimum": 0 },
                "baselineMedianMs": { "$ref": "#/$defs/nullableNumber" },
                "baselineP95Ms": { "$ref": "#/$defs/nullableNumber" },
                "medianChangePercent": { "$ref": "#/$defs/nullableNumber" },
                "p95ChangePercent": { "$ref": "#/$defs/nullableNumber" }
            }
        }
    }
}
