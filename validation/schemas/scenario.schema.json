{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://ballisticsworkbench.local/schemas/validation-scenario.schema.json",
    "title": "Ballistics Workbench independent trajectory scenarios",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "id",
        "reference",
        "atmosphere",
        "aerodynamicChecks",
        "scenarios"
    ],
    "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
        "reference": {
            "type": "object",
            "additionalProperties": false,
            "required": ["implementation", "dragData", "integrator", "stepM", "generatedAt"],
            "properties": {
                "implementation": { "type": "string", "minLength": 1 },
                "dragData": { "type": "string", "minLength": 1 },
                "integrator": { "type": "string", "minLength": 1 },
                "stepM": { "type": "number", "exclusiveMinimum": 0 },
                "generatedAt": { "type": "string", "format": "date" }
            }
        },
        "atmosphere": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "temperatureC",
                "stationPressureHpa",
                "relativeHumidityPercent",
                "headwindMps",
                "crosswindMps"
            ],
            "properties": {
                "temperatureC": { "type": "number" },
                "stationPressureHpa": { "type": "number", "exclusiveMinimum": 0 },
                "relativeHumidityPercent": { "type": "number", "minimum": 0, "maximum": 100 },
                "headwindMps": { "type": "number" },
                "crosswindMps": { "type": "number" }
            }
        },
        "aerodynamicChecks": {
            "type": "array",
            "minItems": 5,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["mach", "dragCoefficient", "ballisticCoefficient", "accelerationMps2"],
                "properties": {
                    "mach": { "type": "number", "minimum": 0 },
                    "dragCoefficient": { "type": "number", "exclusiveMinimum": 0 },
                    "ballisticCoefficient": { "type": "number", "exclusiveMinimum": 0 },
                    "accelerationMps2": { "type": "number", "minimum": 0 }
                }
            }
        },
        "scenarios": {
            "type": "array",
            "minItems": 3,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "regime",
                    "muzzleVelocityMps",
                    "ballisticCoefficient",
                    "maximumDistanceM",
                    "tolerances",
                    "samples"
                ],
                "properties": {
                    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
                    "regime": { "enum": ["supersonic", "transonic", "subsonic"] },
                    "muzzleVelocityMps": { "type": "number", "exclusiveMinimum": 0 },
                    "ballisticCoefficient": { "type": "number", "exclusiveMinimum": 0 },
                    "maximumDistanceM": { "type": "number", "exclusiveMinimum": 0 },
                    "tolerances": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["velocityRelative", "timeRelative", "positionAbsoluteM"],
                        "properties": {
                            "velocityRelative": { "type": "number", "exclusiveMinimum": 0 },
                            "timeRelative": { "type": "number", "exclusiveMinimum": 0 },
                            "positionAbsoluteM": { "type": "number", "exclusiveMinimum": 0 }
                        }
                    },
                    "samples": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["distanceM", "speedMps", "timeS", "verticalPositionM"],
                            "properties": {
                                "distanceM": { "type": "number", "minimum": 0 },
                                "speedMps": { "type": "number", "minimum": 0 },
                                "timeS": { "type": "number", "minimum": 0 },
                                "verticalPositionM": { "type": "number" }
                            }
                        }
                    }
                }
            }
        }
    }
}
