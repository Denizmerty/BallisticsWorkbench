{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://ballisticsworkbench.local/schemas/manufacturer-conformance-report.schema.json",
    "title": "Ballistics Workbench manufacturer-table conformance report",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "reportType",
        "engineVersion",
        "modelVersion",
        "compiler",
        "evidenceLevel",
        "atmosphere",
        "passed",
        "loads"
    ],
    "properties": {
        "schemaVersion": { "const": 1 },
        "reportType": { "const": "manufacturer_table_conformance" },
        "engineVersion": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": "string", "minLength": 1 },
        "compiler": { "type": "string", "minLength": 1 },
        "evidenceLevel": { "const": "manufacturer_conformance" },
        "atmosphere": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "temperatureC",
                "stationPressureHpa",
                "relativeHumidityPercent",
                "headwindMps",
                "crosswindMps",
                "status"
            ],
            "properties": {
                "temperatureC": { "type": "number" },
                "stationPressureHpa": { "type": "number", "exclusiveMinimum": 0 },
                "relativeHumidityPercent": { "type": "number", "minimum": 0, "maximum": 100 },
                "headwindMps": { "type": "number" },
                "crosswindMps": { "type": "number" },
                "status": { "const": "assumed_not_published" }
            }
        },
        "passed": { "type": "boolean" },
        "loads": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "loadId",
                    "sourceDatasetIds",
                    "sourceQualification",
                    "parameterStatus",
                    "toleranceVelocityRelative",
                    "maximumVelocityRelative",
                    "passed",
                    "samples"
                ],
                "properties": {
                    "loadId": { "type": "string", "minLength": 1 },
                    "sourceDatasetIds": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": { "type": "string", "minLength": 1 }
                    },
                    "sourceQualification": {
                        "enum": [
                            "primary_manufacturer_publication",
                            "manufacturer_attributed_secondary_publication"
                        ]
                    },
                    "parameterStatus": {
                        "enum": ["manufacturer_published", "fitted_to_same_table"]
                    },
                    "toleranceVelocityRelative": { "type": "number", "exclusiveMinimum": 0 },
                    "maximumVelocityRelative": { "type": "number", "minimum": 0 },
                    "passed": { "type": "boolean" },
                    "samples": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "distanceM",
                                "publishedVelocityMps",
                                "predictedVelocityMps",
                                "velocityRelativeResidual"
                            ],
                            "properties": {
                                "distanceM": { "type": "number", "minimum": 0 },
                                "publishedVelocityMps": { "type": "number", "exclusiveMinimum": 0 },
                                "predictedVelocityMps": { "type": "number", "exclusiveMinimum": 0 },
                                "velocityRelativeResidual": { "type": "number", "minimum": 0 }
                            }
                        }
                    }
                }
            }
        }
    }
}
