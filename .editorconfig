root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,hpp,ts,tsx,js,cjs,json,css,md,yml,yaml}]
indent_style = space
indent_size = 2

[*.{vcxproj,props}]
indent_style = space
indent_size = 2
end_of_line = crlf

[*.sln]
indent_style = tab
indent_size = 4
end_of_line = crlf

[*.cmd]
indent_style = space
indent_size = 2
end_of_line = crlf
